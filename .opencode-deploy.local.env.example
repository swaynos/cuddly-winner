# Local overrides for scripts/deploy-opencode-agents.sh
# Copy this file to .opencode-deploy.local.env and adjust values.

# Source directory for agent markdown files.
# Relative paths are resolved from repo root.
OPENCODE_DEPLOY_SOURCE_DIR=agents

# OpenCode config directory. If unset, script uses `opencode debug paths` -> config.
# OPENCODE_DEPLOY_CONFIG_DIR=~/.config/opencode

# OpenCode agents directory. If unset, defaults to <config>/agents.
# OPENCODE_DEPLOY_AGENTS_DIR=~/.config/opencode/agents

# OpenCode plugins directory. If unset, defaults to <config>/plugins.
# The managed-agent immutability hook is installed by default. The Autonomous
# supervisor additionally uses this directory with `--with-autonomous`.
# OPENCODE_DEPLOY_PLUGINS_DIR=~/.config/opencode/plugins

# OpenCode skills directory. If unset, defaults to <config>/skills.
# Used with `--with-skills`.
# OPENCODE_DEPLOY_SKILLS_DIR=~/.config/opencode/skills

# OpenCode tools directory. If unset, defaults to <config>/tools.
# Used with `--with-autonomous` or the lower-level `--with-tools` option.
# OPENCODE_DEPLOY_TOOLS_DIR=~/.config/opencode/tools

# Install mode: copy (default and recommended) or symlink.
OPENCODE_DEPLOY_MODE=copy
