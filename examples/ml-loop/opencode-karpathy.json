{
  "strategy_doc": "program.md",
  "log_file": "experiments.md",
  "baseline_command": "python3 train.py",
  "score_source": {
    "type": "file",
    "path": "logs/latest_score.txt",
    "format": "float",
    "direction": "maximize"
  },
  "noise_probe": {
    "command": "python3 train.py",
    "env_overrides": [
      "TRAIN_SEED=1",
      "TRAIN_SEED=2",
      "TRAIN_SEED=3"
    ]
  },
  "immutable_targets": ["prepare.py"],
  "mutable_targets": ["train.py"]
}
