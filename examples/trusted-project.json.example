{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Trusted-project mode. Copy to .opencode/opencode.json in projects where you want agents to run without permission prompts. Do NOT commit this file to shared repos unless all contributors have opted in to this trust level.",

  "permission": {
    "bash":     "allow",
    "edit":     "allow",
    "write":    "allow",
    "read":     "allow",
    "webfetch": "allow",

    "external_directory": {
      "*": "ask"
    }
  }
}
