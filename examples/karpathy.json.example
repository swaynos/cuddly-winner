{
  "_comment": "Copy to opencode-autonomous.json and replace placeholders.",
  "schema_version": 3,
  "strategy": "karpathy",
  "invariants": ["The evaluator remains unchanged"],
  "implementation_scope": ["<mutable/path>"],
  "escalation_triggers": ["objective changes"],
  "evaluator_inventory": [".prometheus/evaluator/<evaluator>"],
  "verification": {
    "commands": ["<final verification command>"],
    "baseline": "<observed baseline summary>"
  },
  "optimization": {
    "objective": "<metric>",
    "direction": "maximize",
    "baseline": 0.0,
    "score_extraction": "<how Autonomous reads one finite score>",
    "noise_probe": {"runs": 3, "threshold": 0.0},
    "mutable_targets": ["<mutable/path>"],
    "immutable_targets": [".prometheus/evaluator/<evaluator>"],
    "limits": {"experiments": 20, "failure_pivot": 5},
    "stop": {"target": 1.0, "exhaustion": "experiments"}
  }
}
