{
  "schema_version": 2,
  "strategy": "karpathy",
  "invariants": [
    "The evaluator is frozen for the whole run"
  ],
  "implementation_scope": [
    "model/**"
  ],
  "escalation_triggers": [
    "objective redefinition"
  ],
  "evaluator_inventory": [
    ".prometheus/evaluator/score.py"
  ],
  "verification": {
    "commands": [
      "python .prometheus/evaluator/score.py"
    ],
    "baseline": "score=0.412 at HEAD"
  },
  "optimization": {
    "objective": "validation_loss",
    "direction": "minimize",
    "baseline": 0.412,
    "score_extraction": "last float on stdout",
    "noise_probe": {
      "runs": 3,
      "threshold": 0.005
    },
    "mutable_targets": [
      "model/hyperparams.json"
    ],
    "immutable_targets": [
      ".prometheus/evaluator/score.py"
    ],
    "limits": {
      "experiments": 40,
      "failure_pivot": 5
    },
    "stop": {
      "target": 0.30,
      "exhaustion": "experiments"
    }
  }
}
