# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python C extensions
*.so

# Python distribution / packaging
build/
dist/
*.egg-info/

# PyInstaller
*.manifest
*.spec

# Python environments
# pyenv — THIS PROJECT USES PYENV + VIRTUALENV. NEVER USE SYSTEM PYTHON.
# Commit .python-version so everyone uses the same interpreter.
# .python-version
.venv/
venv/
env/
ENV/

# Environment files
.env
.envrc

# Testing / coverage / static analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Playwright
.playwright-mcp

# Obscura browser engine binaries, installed under the OpenCode config root.
cuddly-winner-browser/

# Operating System files
.DS_Store
Thumbs.db

# Project-specific paths
evals/seed_build/reports/
*.log

# Local feedback may contain private source paths, session IDs, and excerpts.
/feedback/

# Spike workspaces are disposable and never committed
.spike/

# Per-pass task-loop evidence is local to a run, not source.
.task-loop/

# BEGIN OpenCode generated task artifacts
/.opencode/generated-agents.json
/.opencode/tasks/
/.spike/
# END OpenCode generated task artifacts
