# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python C extensions
*.so

# Python distribution / packaging
build/
dist/
*.egg-info/

# PyInstaller
*.manifest
*.spec

# Python environments
# pyenv — THIS PROJECT USES PYENV + VIRTUALENV. NEVER USE SYSTEM PYTHON.
# Commit .python-version so everyone uses the same interpreter.
# .python-version
.venv/
venv/
env/
ENV/

# Environment files
.env
.envrc
# Local secrets files referenced by the browser credential registry.
*.secret.env

# Testing / coverage / static analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Playwright
.playwright-mcp

# Operating System files
.DS_Store
Thumbs.db

# Project-specific paths
*.log

# Local feedback may contain private source paths, session IDs, and excerpts.
/feedback/

# ChatGPT image-generation downloads, prompts, and run evidence are private.
/.chatgpt-image-generation/

# Goal Agents are local task output published by Prometheus or Build.
/.opencode/agents/generated/
